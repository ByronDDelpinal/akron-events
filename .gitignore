# dependencies
node_modules
.pnp
.pnp.js

# build output
dist
dist-verify
dist-check-*
dist-ssr

# Vite config cache — timestamped .mjs snapshots created during dev server startup
vite.config.js.timestamp-*

# env files — never commit real credentials
.env
.env.local
.env.*.local

# editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
._*

# FUSE bookkeeping. When a file is deleted while another process still has it
# open, a FUSE-backed mount can't drop the inode the way a native filesystem
# does, so libfuse renames it to .fuse_hiddenXXXX instead and cleans up on the
# final close. If that process dies first, the file is orphaned. Editors that
# rewrite in place (perl -i, sed -i) trigger this on any FUSE mount — which
# includes the folder-sharing mounts used by containers, VMs and agent
# sandboxes. Untracked AND unignored, these are one `git add .` from the repo.
.fuse_hidden*

# agent worktrees: linked git worktrees (e.g. agents/nightly) live here
.worktrees/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# scrape:all run-health reports — local only, regenerated each run (see scripts/scrape-report.js)
scrape-reports/

# raw / uncompressed video source files — only the compressed output belongs in the repo
public/video/*-source.*

# local docs — diagrams, exports, reference material. Also the home for design
# source: docs/design-source/ holds the designer's originals (category glyphs,
# logo kits). Only the processed, code-referenced exports belong in public/.
#
# Allowlist pattern: `docs/*` (not `docs/`) so individual files can be
# re-included below — git cannot negate a path inside an ignored DIRECTORY,
# but it can negate a file when only the directory's *contents* are ignored.
# Only public-safe operational playbooks are allowlisted; everything else in
# docs/ (audits, partner/contact material, working notes, binaries) stays
# local by design. Add a negation only with maintainer sign-off.
docs/*
!docs/festival-playbook.md
!docs/qa-sanity-tests.md

# design source files — originals belong in docs/design-source/, never in the
# repo. These reached the root and public/ once already: 19 category-glyph
# SVGs sat in the project root duplicating public/*_pulse.svg, and a .psd plus
# a .zip logo kit sat in public/ where they deployed to the CDN and were
# publicly downloadable despite no code referencing them.
*.psd
*.psb
*.ai
*.sketch
*.fig

# agent memory — Cowork writes per-space memory under spaces/<uuid>/memory/.
# That is session state, not project source; a memory file was committed here
# once already. Never belongs in the repo.
spaces/

# local design explorations — mood boards, palette studies, etc.
design-proposals/

# vendored skill content — managed by skills-lock.json; re-sync locally
.agents/
.claude/skills/

# raw GIS source shapefiles — too large for git (Census TIGER files
# regularly exceed GitHub's 100 MB single-file limit). The conversion
# scripts in scripts/convert-*.js emit the compact GeoJSON we ship
# into public/, which IS committed.
data/gis/us_county_boundaries/
data/gis/ohio_places/
data/gis/ohio_county_subs/

# content-moderation blocklist — NEVER commit. The list lives only in the
# MODERATION_TERMS_B64 environment variable (see scripts/encode-moderation-terms.js).
# A local copy under data/moderation/ exists only for editing and re-encoding.
data/moderation/
.worktrees/
.tmp-*
.claude/settings.local.json
