# Copy this file to .env and fill in your values.

# ── Supabase (Settings → API) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase service role — server/scripts only, NEVER commit ──────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Eventbrite (restricted — search API not available for new keys) ─
EVENTBRITE_API_KEY=your-eventbrite-private-token-here

# ── Ticketmaster (developer.ticketmaster.com — free, instant) ──────
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key-here

# ── Dice.fm (dice.fm partner API — venues that sell exclusively through DICE) ──
DICE_API_KEY=your-dice-partner-api-key-here

# ── Content moderation blocklist — base64-encoded, see scripts/encode-moderation-terms.js ──
MODERATION_TERMS_B64=your-base64-encoded-blocklist-here

# ── Vercel edge-cache purge (optional — cache self-heals via TTL if unset) ──
VERCEL_TOKEN=your-vercel-api-token-here
VERCEL_PROJECT_ID=your-vercel-project-id-or-name-here
VERCEL_TEAM_ID=your-vercel-team-id-here

# ── Optional direct ICS feed URLs — each overrides the scraper's own discovery/hardcoded default ──
AKRON_POWER_SQUADRON_ICS_URL=https://example.org/calendar.ics    # optional — hardcoded fallback candidates exist
AKRON_PUBLIC_SCHOOLS_ICS_URL=https://example.org/calendar.ics    # REQUIRED in practice — no hardcoded fallback, scraper throws if discovery fails
AKRON_SYMPHONY_ICS_URL=https://example.org/calendar.ics          # optional — hardcoded fallback exists
CITY_OF_GREEN_ICS_URL=https://example.org/calendar.ics           # optional — hardcoded fallback exists
FULL_GRIP_GAMES_ICS_URL=https://example.org/calendar.ics         # optional — hardcoded fallback exists
LIFE_GURUKULA_ICS_URL=https://example.org/calendar.ics           # optional — hardcoded fallback exists
NORTH_HILL_CDC_ICS_URL=https://example.org/calendar.ics          # optional — hardcoded fallback candidates exist
PENINSULA_ART_ACADEMY_ICS_URL=https://example.org/calendar.ics   # optional — hardcoded fallback exists

# ── Google Analytics 4 (analytics.google.com) ───────────────────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Slack notifications — Tier 2 (agent-authored reports) ───────────
# SLACK_AGENT_SECRET is the TASK-SIDE shared secret: our own role agents
# (.claude/agents/) send it as the X-Slack-Agent-Secret header when POSTing
# a daily_report/night_crew update to the slack-notify edge function. It is
# a DIFFERENT secret from SLACK_NOTIFY_SECRET (the DB-trigger-side secret
# documented in README.md's Slack section) — the two authenticate different
# callers with different capabilities (see slack-notify/index.ts's auth
# gate), so they must never be set to the same value. Set with
# `supabase secrets set SLACK_AGENT_SECRET='<value>'`; this repo's own
# scripts/tasks that post Tier 2 reports read it from wherever they run,
# not from this file.
SLACK_AGENT_SECRET=your-agent-side-shared-secret-here
