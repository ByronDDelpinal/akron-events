{"contents":"      \u003clink rel=\"stylesheet\" href=\"https://brandedweb-assets.mindbodyonline.com/assets/fonts-lato-1f8731d8fae2efa72dd887473cfea8e150e1eaed44468aa79197df0888058e89.css\" media=\"screen\" /\u003e\n    \u003clink rel=\"stylesheet\" href=\"https://brandedweb-assets.mindbodyonline.com/assets/widgets/themes/enrollment/modern-7560a5e557ec7f099af6e9da7b1b19c28f8855c2fdc4b925e43c900369ff0d38.css\" media=\"screen\" /\u003e\n  \n  \u003cstyle type=\"text/css\"\u003e\n  \n  \n  \u003c/style\u003e\n  \u003cstyle type=\"text/css\"\u003e\n    .hc_footer { text-align: right; }\n    .hc-privacy-footer { margin-top: 1em; }\n    .hc_footer img, .hc-privacy-footer img { width: auto; height: 1.25rem; }\n    .hc-privacy-footer .widget-privacy-link { float: right; margin-top: 0.6em; }\n    .hc-privacy-footer .privacy-policy-link { color: #696C74; }\n  \u003c/style\u003e\n\n\u003cscript\u003e\n  // Use var instead of const to allow redeclaration if script loads multiple times\n  var CONSUMER_VISITOR = 'Consumer visitor';\n  \n  function putMBVisitorId(visitorId) {\n    const hostParts = window.location.hostname.split('.');\n    const host = hostParts.length \u003e 2 ? hostParts.slice(1).join('.') : hostParts.join('.');\n    const date = new Date(Date.now() + 31536000000);  // 12 months in milliseconds. According to GDPR directive - https://gdpr.eu/cookies/\n    document.cookie = `mbvid=${visitorId};expires=${date.toUTCString()};path=/;domain=.${host};SameSite=None;Secure`;\n  }\n\n  function getMBVisitorIdFromURL() {\n    const urlParams = new URLSearchParams(window.location.search);\n    if (urlParams.has('mbvid')) {\n      const visitorId = urlParams.get('mbvid');\n      putMBVisitorId(visitorId);\n      return visitorId;\n    }\n    return null;\n  }\n\n  function getMBVisitorIdFromCookie() {\n    const fullCookieString = `; ${document.cookie}`;\n    const splitByCookieName = fullCookieString.split(`; mbvid=`);\n    if (splitByCookieName.length \u003e 1) {\n      return splitByCookieName.pop().split(';')[0];\n    }\n    return null;\n  }\n\n  function generateMBVisitorId() {\n    return import('https://openfpcdn.io/fingerprintjs/v3')\n      .then(FingerprintJS =\u003e FingerprintJS.load())\n      .then(fp =\u003e fp.get())\n      .then(result =\u003e {\n        putMBVisitorId(result.visitorId);\n        return result.visitorId;\n      }).catch(() =\u003e {\n        let visitorId = window.URL.createObjectURL(new Blob([])).split('/').pop() // Generate a UUID if fingerprint.js fails\n        putMBVisitorId(visitorId);\n        return visitorId;\n      })\n  }\n\n  function getMBVisitorId() {\n    return new Promise((resolve, reject) =\u003e {\n      // 1. Does it have MB_VISITOR_ID in the query string parameters? If so, save that and use\n      const visitorIdFromURL = getMBVisitorIdFromURL();\n      if (visitorIdFromURL) {\n        resolve(visitorIdFromURL);\n        return;\n      }\n\n      // 2. Does it have MB_VISITOR_ID in the cookie? If so, use that\n      const visitorIdFromCookie = getMBVisitorIdFromCookie();\n      if (visitorIdFromCookie) {\n        resolve(visitorIdFromCookie);\n        return;\n      }\n\n      // 3. Use fingerprint.js to generate MB_VISITOR_ID cookie, use that\n      generateMBVisitorId().then(visitorId =\u003e resolve(visitorId));\n    });\n  }\n\n  (function(apiKey){\n    (function(p,e,n,d,o){var v,w,x,y,z;o=p[d]=p[d]||{};o._q=[];\n    v=['initialize','identify','updateOptions','pageLoad'];for(w=0,x=v.length;w\u003cx;++w)(function(m){\n        o[m]=o[m]||function(){o._q[m===v[0]?'unshift':'push']([m].concat([].slice.call(arguments,0)));};})(v[w]);\n        y=e.createElement(n);y.async=!0;y.src='https://cdn.pendo.io/agent/static/'+apiKey+'/pendo.js';\n        z=e.getElementsByTagName(n)[0];z.parentNode.insertBefore(y,z);})(window,document,'script','pendo');\n\n        // Only initialize Pendo for non-consumer visitors\n        if ('Consumer visitor' !== CONSUMER_VISITOR) {\n          getMBVisitorId().then(function(visitorId) {\n            pendo.initialize({\n              visitor: {\n                id: visitorId, // \n                user_type: 'Consumer visitor', // \n                user_role: 'consumer', // \n              },\n              account: {\n                id: 38539 // \n              }\n            });\n\n            // \n          });\n        }\n  })('b2e281d9-e4d2-4363-53eb-0d2455ab61b8');\n\n  // Track retry attempts for each event\n  const pendoRetryTracker = {};\n  const MAX_PENDO_RETRIES = 5;\n\n  function pendoTrack(name, data) {\n    if (pendo?.isReady \u0026\u0026 pendo.isReady()) {\n      // Reset retry count on successful tracking\n      if (pendoRetryTracker[name]) {\n        pendoRetryTracker[name] = 0;\n      }\n      \n      const host = window.location.host;\n      const managerPreviewHost = \"brandedweb.\";\n      const managerEventsArr = '[\"Manager | Base Style Selected | Click\", \"Manager | Save Deploy Widget | Click\"]';\n      const widgetsEventsArr = '[\"Widget | Appointments | View\", \"Widget | Classes | View\", \"Widget | Enrollments | View\", \"Widget | Prospects | View\", \"Widget | Registrations | View\", \"Widget | Schedule | View\", \"Widget | Staff List | View\", \"Widget | Appointments | Select Date\", \"Widget | Appointments | Search\", \"Widget | Appointments | Select Appointment Type\", \"Widget | Appointments | Select Time\", \"Widget | Appointments | Select Instructor\", \"Widget | Appointments | Select Location\", \"Widget | Appointments | No Results\"]';\n\n      // Captures \"view\" events in manager preview where host has not loaded quick enough\n      if (host === \"\"){\n        return;\n      }\n\n      if ((host.includes(managerPreviewHost) \u0026\u0026 managerEventsArr.includes(name)) || (!host.includes(managerPreviewHost) \u0026\u0026 widgetsEventsArr.includes(name))) {\n        return pendo.track(name, data);\n      }\n    } else if ('Consumer visitor' !== CONSUMER_VISITOR) {\n      // Initialize retry counter for this event if needed\n      if (!pendoRetryTracker[name]) {\n        pendoRetryTracker[name] = 0;\n      }\n      \n      // Only retry if we haven't exceeded max retries\n      if (pendoRetryTracker[name] \u003c MAX_PENDO_RETRIES) {\n        pendoRetryTracker[name]++;\n        setTimeout(function() {\n          pendoTrack(name, data);\n        }, 500);\n      }\n    }\n  }\n\n\u003c/script\u003e\n\n\u003cdiv class=\"healcode enrollments modern-theme-wrapper detail\" id=\"fe114957e7e9\" data-hc-widget-serial=\"018a05a603a7a85fd3b33b3f1698e2857ef9a887678a3855660b654d56cdb662\" data-widget-name=enrollment\ndata-view-type=detail\n\u003e\n  \u003cdiv class=\"navigation\"\u003e\n        \u003ca class=\"action_icon print_version\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Print schedule\" href=\"https://widgets.mindbodyonline.com/widgets/enrollments/fe114957e7e9/print\"\u003e          \u003cimg src=\"https://brandedweb-assets.mindbodyonline.com/assets/icons/Printer-fdd68ca834ee03e2d456fab42800a78f42fc8a7ec7566afd79e8c25595853d3c.svg\" /\u003e\u003c/a\u003e      \u003ca data-url=\"https://cart.mindbodyonline.com/sites/29325/cart?theme=modern\u0026amp;widget_type=enrollment\" data-bw-identity-site=\"true\" data-hc-open-modal=\"modal-iframe\" class=\"action_icon cart_version\" title=\"Cart\" rev=\"iframe\" href=\"\"\u003e\u003cimg src=\"https://brandedweb-assets.mindbodyonline.com/assets/icons/Cart-6242fc5a2ec9a80a0d755e79b28a8dc77ffbb3ba388ae2141de38d3a644c6f04.svg\" /\u003e\u003c/a\u003e\n      \u003cdiv class=\"vertical-divider\"\u003e\u003c/div\u003e\n      \u003ca data-url=\"https://cart.mindbodyonline.com/sites/29325/client?theme=modern\u0026amp;widget_type=enrollment\" data-bw-identity-site=\"true\" data-hc-open-modal=\"modal-iframe\" class=\"action_icon my_account_version\" title=\"My Account\" rev=\"iframe\" href=\"\"\u003e\u003cspan class=\"action_text my_account_text\"\u003eMy Account\u003c/span\u003e\u003c/a\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"header\"\u003e\n    \u003ch1\u003e\n      \u003cspan class=\"healcode-title-text add-new-line\"\u003e\n          Enrollments for\n      \u003c/span\u003e\n      \u003cspan class=\"hc_header_time\"\u003e\n  \u003cspan class=\"hc_header_month\"\u003eNovember\u003c/span\u003e \u003cspan class=\"hc_header_day\"\u003e10\u003c/span\u003e\u003cspan class=\"hc_header_year\"\u003e, 2026\u003c/span\u003e\n-\n  \u003cspan class=\"hc_header_month\"\u003eDecember\u003c/span\u003e \u003cspan class=\"hc_header_day\"\u003e 9\u003c/span\u003e\u003cspan class=\"hc_header_year\"\u003e, 2026\u003c/span\u003e\n\u003c/span\u003e\n\n    \u003c/h1\u003e\n    \u003cdiv class=\"filters\"\u003e\n        \u003cselect name=\"mbo_class\" id=\"mbo_class\"\u003e\u003coption value=\"\"\u003eAll Classes\u003c/option\u003e\u003coption value=\"794\"\u003eAerial UnWined - $18\u003c/option\u003e\n\u003coption value=\"732\"\u003eFull Moon Flow w/ Inspired Cocktail \u0026amp; Bonfire - $18\u003c/option\u003e\n\u003coption value=\"724\"\u003eTranscendent Breathwork Experience - $39\u003c/option\u003e\u003c/select\u003e\n\n  \u003cselect name=\"trainer\" id=\"trainer\"\u003e\u003coption value=\"\"\u003eAll instructors\u003c/option\u003e\u003coption value=\"100000231\"\u003eBetsy Adamson-Stakley\u003c/option\u003e\n\u003coption value=\"100000256\"\u003eMary Laske Bell, PhD\u003c/option\u003e\n\u003coption value=\"100000004\"\u003ePattie Wagner (E-RYT 500/YACEP)\u003c/option\u003e\u003c/select\u003e\n\n  \u003cdiv class=\"filter_time_of_day checkboxes\" id=\"time_of_day\"\u003e\n    \u003cdiv\u003e\n      \u003cinput type=\"checkbox\" name=\"time_of_day\" id=\"morning_check\" value=\"0\" /\u003e\n      \u003clabel for=\"morning_check\"\u003eMorning\u003c/label\u003e\n    \u003c/div\u003e\n\n    \u003cdiv\u003e\n      \u003cinput type=\"checkbox\" name=\"time_of_day\" id=\"afternoon_check\" value=\"1\" /\u003e\n      \u003clabel for=\"afternoon_check\"\u003eAfternoon\u003c/label\u003e\n    \u003c/div\u003e\n\n    \u003cdiv\u003e\n      \u003cinput type=\"checkbox\" name=\"time_of_day\" id=\"evening_check\" value=\"2\" /\u003e\n      \u003clabel for=\"evening_check\"\u003eEvening\u003c/label\u003e\n    \u003c/div\u003e\n\u003c/div\u003e\n\n\n      \u003cscript\u003e\n//\u003c![CDATA[\nhcFilterSessions.addNewSessionFilter('fe114957e7e9', 'enrollment', hcjq('*[data-widget-id=\"fe114957e7e9\"]'));\n//]]\u003e\n\u003c/script\u003e\n      \u003cimg style=\"display:none;\" id=\"spinner\" src=\"https://brandedweb-assets.mindbodyonline.com/assets/widgets/spinner-b6598adeb0a9b68f73d84542c6913a37b6765ebbb8cb6aba6b869a36eae378eb.gif\" /\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"healcode-date-links-area date_links week_links\"\u003e\n      \u003cdiv class=\"healcode-time-period-changer\"\u003e\n        \u003cspan class=\"healcode-previous\"\u003e\n          \u003ca data-hc-startdate=\"2026-10-10\" href=\"/widgets/enrollments/fe114957e7e9\"\u003e\u0026lt; Previous\u003c/a\u003e\n          \u003cspan class=\"healcode-divider\"\u003e | \u003c/span\u003e\n        \u003c/span\u003e\n\n        \u003cspan class=\"healcode-today\"\u003e\n          \u003ca data-hc-startdate=\"2026-11-10\" href=\"/widgets/enrollments/fe114957e7e9\"\u003eToday\u003c/a\u003e\n          \u003cspan class=\"healcode-divider\"\u003e | \u003c/span\u003e\n        \u003c/span\u003e\n\n        \u003cspan class=\"healcode-next\"\u003e\n          \u003ca data-hc-startdate=\"2026-12-10\" href=\"/widgets/enrollments/fe114957e7e9\"\u003eNext \u0026gt;\u003c/a\u003e\n        \u003c/span\u003e\n      \u003c/div\u003e\n      \u003cspan class=\"healcode-jump-to-date\"\u003e\u003cinput type=\"text\" name=\"start_date\" id=\"start_date\" value=\"2026-11-10\" size=\"12\" class=\"datepicker\" data-hc-datepicker-link-params=\"?\" /\u003e\u003cimg class=\"healcode-calendar\" src=\"https://brandedweb-assets.mindbodyonline.com/assets/icons/CalendarTodayOutlined-9852fe1d217ed5a22933c2176d666f2689861341098172d4746000a88cd7e93b.svg\" /\u003e\u003c/span\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"clear\"\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\n  \u003cdiv\u003e\n    \n  \u003c/div\u003e\n  \u003cdiv class=\"filtered_collection\"\u003e\n  \u003cdiv class=\"enrollment filterable  transcendent_breathwork_experience_39 \" id=\"10801640\" data-hc-id=\"10801640\" data-hc-mbo-class=\"724\" data-hc-trainer=\"100000256\" data-hc-time-of-day=\"2\" data-hc-mbo-class-id=\"3599\" data-hc-mbo-class-name=\"transcendent_breathwork_experience_39\"\u003e  \u003cdiv class=\"healcode-image-area\"\u003e\u003cimg src=\"https://clients-content.mindbodyonline.com/studios/release/reservations/724.jpg?osv=638794012970000000\" /\u003e\u003c/div\u003e\n\n      \u003ch2 class=\"healcode-enrollment-name\"\u003e\n      \u003ca href=\"?options%5Bids%5D=3599\u0026amp;options%5Bsite_id%5D=38539\"\u003eTranscendent Breathwork Experience - $39\u003c/a\u003e\n        \u003cspan class=\"healcode-trainer-name\"\u003ewith \u003cspan class=\"trainer\" id=\"item_3599_trainer\"\u003e\u003ca data-url=\"https://widgets.mindbodyonline.com/widgets/staff_lists/fe114957e7e9/staff?site_mbo_id=38539\u0026amp;staff_id=100000256\u0026amp;widget_type=Enrollment\" data-bw-identity-site=\"true\" data-hc-open-modal=\"modal-iframe\" rev=\"iframe\" href=\"\"\u003eMary Laske Bell, PhD\u003c/a\u003e\u003c/span\u003e\u003c/span\u003e\n      \u003c/h2\u003e\n\n\n  \u003cdiv class=\"healcode-date-area\"\u003e\n    \u003cspan class=\"healcode-active-days\"\u003eSun\u003c/span\u003e\n    \u003cspan class=\"healcode-date-value\"\u003eDate: \u003cspan class=\"healcode-start-date-value\"\u003eNov 15 2026\u003c/span\u003e\u003c/span\u003e\n    \u003cspan class=\"healcode-time-value\"\u003eFrom: \u003cspan class=\"healcode-start-time-value\"\u003e 6:00 PM\u003c/span\u003e\u003cspan class=\"healcode-end-time-label\"\u003e - \u003c/span\u003e\u003cspan class=\"healcode-end-time-value\"\u003e 7:30 PM\u003c/span\u003e\u003c/span\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"healcode-description-area\"\u003e\n    \u003cdiv\u003eIn this workshop, you’ll learn to manipulate the breath for relaxation, clarity, healing, and transcendence.\u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003eWhile the breathing technique we use in this workshop is very active and intense, it brings out a powerfully euphoric feeling and people often feel “lighter,” more connected, or peaceful afterwards.\u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003eThe experience includes a brief setup and introduction to the breathwork journey, a guided meditation, and then a community share with post-session care tips at the end.\u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003eBolsters, blankets, blocks are used to ensure your comfort during this transcendent experience.  All levels are welcome.  Yoga mats required. \u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003e\u003cem\u003e\u003cstrong\u003e*Must be at least 16 years old to participate\u003c/strong\u003e\u003c/em\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\n        \u003cdiv class=\"healcode-button\"\u003e\n          \u003ca data-url=\"https://cart.mindbodyonline.com/sites/29325/cart/add_booking?item%5Bclass_schedule_id%5D=3599\u0026amp;item%5Binfo%5D=Sun.+Nov+15%2C+2026++6%3A00+pm\u0026amp;item%5Bmbo_id%5D=3599\u0026amp;item%5Bmbo_location_id%5D=1\u0026amp;item%5Bname%5D=Transcendent+Breathwork+Experience+-+%2439\u0026amp;item%5Btype%5D=Enrollment\u0026amp;theme=modern\u0026amp;widget_type=enrollment\" data-bw-identity-site=\"true\" data-hc-open-modal=\"modal-iframe\" data-site-mbo-id=\"38539\" class=\"hc-button signup_now\" rev=\"iframe\" href=\"\"\u003eSign Up\u003c/a\u003e\n        \u003c/div\u003e\n\n\n  \u003cdiv class=\"clear\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n  \u003cdiv class=\"enrollment filterable  full_moon_flow_w_inspired_cocktail_bonfire_18 \" id=\"10801680\" data-hc-id=\"10801680\" data-hc-mbo-class=\"732\" data-hc-trainer=\"100000231\" data-hc-time-of-day=\"2\" data-hc-mbo-class-id=\"3538\" data-hc-mbo-class-name=\"full_moon_flow_w_inspired_cocktail_amp_bonfire_18\"\u003e  \u003cdiv class=\"healcode-image-area\"\u003e\u003cimg src=\"https://clients-content.mindbodyonline.com/studios/release/reservations/732.jpg?osv=638872819910000000\" /\u003e\u003c/div\u003e\n\n      \u003ch2 class=\"healcode-enrollment-name\"\u003e\n      \u003ca href=\"?options%5Bids%5D=3538\u0026amp;options%5Bsite_id%5D=38539\"\u003eFull Moon Flow w/ Inspired Cocktail \u0026amp; Bonfire - $18\u003c/a\u003e\n        \u003cspan class=\"healcode-trainer-name\"\u003ewith \u003cspan class=\"trainer\" id=\"item_3538_trainer\"\u003e\u003ca data-url=\"https://widgets.mindbodyonline.com/widgets/staff_lists/fe114957e7e9/staff?site_mbo_id=38539\u0026amp;staff_id=100000231\u0026amp;widget_type=Enrollment\" data-bw-identity-site=\"true\" data-hc-open-modal=\"modal-iframe\" rev=\"iframe\" href=\"\"\u003eBetsy Adamson-Stakley\u003c/a\u003e\u003c/span\u003e\u003c/span\u003e\n      \u003c/h2\u003e\n\n\n  \u003cdiv class=\"healcode-date-area\"\u003e\n    \u003cspan class=\"healcode-active-days\"\u003eTue\u003c/span\u003e\n    \u003cspan class=\"healcode-date-value\"\u003eDate: \u003cspan class=\"healcode-start-date-value\"\u003eNov 24 2026\u003c/span\u003e\u003c/span\u003e\n    \u003cspan class=\"healcode-time-value\"\u003eFrom: \u003cspan class=\"healcode-start-time-value\"\u003e 7:00 PM\u003c/span\u003e\u003cspan class=\"healcode-end-time-label\"\u003e - \u003c/span\u003e\u003cspan class=\"healcode-end-time-value\"\u003e 8:30 PM\u003c/span\u003e\u003c/span\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"healcode-description-area\"\u003e\n    \u003cdiv\u003eJoin Betsy as she guides you through a Full Moon Yoga flow, complete with Moon Salutations and fascinating insights about the power and energy we draw from moon phases. \u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003eClass will be held outdoors from 7 - 8:30 pm with a small bonfire, weather permitting.  Indoors if necessary.\u003cbr\u003e\u003cbr\u003eFull Moon themed cocktails/mocktails included! \u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003e***\u003c/div\u003e\u003cdiv\u003e \u003c/div\u003e\u003cdiv\u003ePlease note, this event requires 3 pre-enrollments 24 hours in advance.  Thank you for pre-enrolling! \u003c/div\u003e\n  \u003c/div\u003e\n\n        \u003cdiv class=\"healcode-button\"\u003e\n          \u003ca data-url=\"https://cart.mindbodyonline.com/sites/29325/cart/add_booking?item%5Bclass_schedule_id%5D=3538\u0026amp;item%5Binfo%5D=Tue.+Nov+24%2C+2026++7%3A00+pm\u0026amp;item%5Bmbo_id%5D=3538\u0026amp;item%5Bmbo_location_id%5D=1\u0026amp;item%5Bname%5D=Full+Moon+Flow+w%2F+Inspired+Cocktail+%26+Bonfire+-+%2418\u0026amp;item%5Btype%5D=Enrollment\u0026amp;theme=modern\u0026amp;widget_type=enrollment\" data-bw-identity-site=\"true\" data-hc-open-modal=\"modal-iframe\" data-site-mbo-id=\"38539\" class=\"hc-button signup_now\" rev=\"iframe\" href=\"\"\u003eSign Up\u003c/a\u003e\n        \u003c/div\u003e\n\n\n  \u003cdiv class=\"clear\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n  \u003cdiv class=\"enrollment filterable  aerial_unwined_18 \" id=\"10801720\" data-hc-id=\"10801720\" data-hc-mbo-class=\"794\" data-hc-trainer=\"100000004\" data-hc-time-of-day=\"2\" data-hc-mbo-class-id=\"3583\" data-hc-mbo-class-name=\"aerial_unwined_18\"\u003e  \u003cdiv class=\"healcode-image-area\"\u003e\u003cimg src=\"https://clients-content.mindbodyonline.com/studios/release/reservations/794.jpg?osv=639112691820000000\" /\u003e\u003c/div\u003e\n\n      \u003ch2 class=\"healcode-enrollment-name\"\u003e\n      \u003ca href=\"?options%5Bids%5D=3583\u0026amp;options%5Bsite_id%5D=38539\"\u003eAerial UnWined - $18\u003c/a\u003e\n        \u003cspan class=\"healcode-trainer-name\"\u003ewith \u003cspan class=\"trainer\" id=\"item_3583_trainer\"\u003e\u003ca data-url=\"https://widgets.mindbodyonline